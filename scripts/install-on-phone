#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

if [ "$(id -u)" -ne 0 ]; then
	echo "install-on-phone must run as root" >&2
	exit 1
fi

for path in build/libnlnfc.so packaging/reader.conf \
		packaging/pcscd.service.d/oneplus-nfc.conf \
		packaging/oneplus-nfc-init.service scripts/oneplus-nfc-init; do
	if [ ! -f "$path" ]; then
		echo "missing $path; run this from a built project checkout" >&2
		exit 1
	fi
done

systemctl stop pcscd.socket pcscd.service oneplus-nfc-init.service \
	2>/dev/null || true

if [ -e /usr/local/lib/libnlnfc.so.0.0.0 ]; then
	backup="/usr/local/lib/libnlnfc.so.0.0.0.$(date +%Y%m%d-%H%M%S).bak"
	cp -p /usr/local/lib/libnlnfc.so.0.0.0 "$backup"
	echo "Backed up existing driver to $backup"
fi

install -d /usr/local/lib /usr/local/libexec /etc/reader.conf.d \
	/etc/systemd/system/pcscd.service.d
install -m 0755 build/libnlnfc.so /usr/local/lib/libnlnfc.so.0.0.0
ln -sfn libnlnfc.so.0.0.0 /usr/local/lib/libnlnfc.so.0
ln -sfn libnlnfc.so.0.0.0 /usr/local/lib/libnlnfc.so
install -m 0755 scripts/oneplus-nfc-init /usr/local/libexec/oneplus-nfc-init
install -m 0644 packaging/reader.conf /etc/reader.conf.d/libnlnfc
install -m 0644 packaging/pcscd.service.d/oneplus-nfc.conf \
	/etc/systemd/system/pcscd.service.d/oneplus-nfc.conf
install -m 0644 packaging/oneplus-nfc-init.service \
	/etc/systemd/system/oneplus-nfc-init.service
rm -f /usr/local/sbin/oneplus-nfc-recover
rm -f /etc/systemd/system/pcscd.socket.wants/oneplus-nfc-init.service

systemctl daemon-reload
systemctl stop oneplus-nfc-init.service 2>/dev/null || true
systemctl enable --now pcscd.socket
systemctl restart pcscd.service

echo "Installed OnePlus NFC PC/SC bridge"
