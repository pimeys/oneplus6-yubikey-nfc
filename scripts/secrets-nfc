#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
set -eu

overlay=/usr/local/share/oneplus-secrets-nfc
if [ -n "${PYTHONPATH:-}" ]; then
	export PYTHONPATH="$overlay:$PYTHONPATH"
else
	export PYTHONPATH="$overlay"
fi

secrets_bin=${SECRETS_BIN:-/usr/bin/secrets}
secrets_pattern="^/usr/bin/python3 /usr/bin/secrets( |$)"

application_responds()
{
	timeout 2 gdbus call --session \
		--dest org.gnome.World.Secrets \
		--object-path /org/gnome/World/Secrets \
		--method org.gtk.Actions.List >/dev/null 2>&1
}

stop_unresponsive_instance()
{
	if pgrep -u "$(id -u)" -f "$secrets_pattern" >/dev/null \
			&& ! application_responds; then
		pkill -u "$(id -u)" -f "$secrets_pattern" 2>/dev/null || true
		sleep 1
		if pgrep -u "$(id -u)" -f "$secrets_pattern" >/dev/null; then
			pkill -KILL -u "$(id -u)" -f "$secrets_pattern" 2>/dev/null || true
			sleep 1
		fi
	fi
}

stop_unresponsive_instance

"$secrets_bin" "$@" &
secrets_pid=$!

# A post-reboot GTK/Phosh race can leave Secrets owning its D-Bus name without
# servicing application actions or presenting a window. Detect that state,
# terminate only the unresponsive Secrets process, and retry once.
for _attempt in 1 2 3; do
	if application_responds; then
		wait "$secrets_pid"
		exit $?
	fi
	if ! kill -0 "$secrets_pid" 2>/dev/null; then
		wait "$secrets_pid"
		exit $?
	fi
	sleep 1
done

kill "$secrets_pid" 2>/dev/null || true
sleep 1
if kill -0 "$secrets_pid" 2>/dev/null; then
	kill -KILL "$secrets_pid" 2>/dev/null || true
fi
wait "$secrets_pid" 2>/dev/null || true

exec "$secrets_bin" "$@"
