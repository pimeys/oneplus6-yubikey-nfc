#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

usage()
{
	echo "usage: $0 --dry-run|--apply" >&2
	exit 2
}

if [ "$#" -ne 1 ]; then
	usage
fi

case "$1" in
	--dry-run|--apply)
		mode=$1
		;;
	*)
		usage
		;;
esac

provider_source=secrets-overlay/gsecrets/provider
provider_destination=/usr/local/share/oneplus-secrets-nfc/gsecrets/provider
wrapper_source=scripts/secrets-nfc
wrapper_destination=/usr/local/bin/secrets-nfc
desktop_source=packaging/org.gnome.World.Secrets.desktop
desktop_destination=/usr/local/share/applications/org.gnome.World.Secrets.desktop
packages="gnome-secrets=9.6-r1 py3-pyscard=2.3.1-r1"

for path in \
	"$provider_source/oneplus_pcsc.py" \
	"$provider_source/secrets_composite.py" \
	"$provider_source/yubikey_provider.py" \
	"$provider_source/providers.py" \
	"$wrapper_source" \
	"$desktop_source"; do
	if [ ! -f "$path" ]; then
		echo "missing $path; run this from the project checkout" >&2
		exit 1
	fi
done

desktop-file-validate "$desktop_source"

if [ "$mode" = "--dry-run" ]; then
	apk add --simulate $packages
	printf '%s\n' \
		"Would install $provider_source/oneplus_pcsc.py -> $provider_destination/oneplus_pcsc.py (0644)" \
		"Would install $provider_source/secrets_composite.py -> $provider_destination/secrets_composite.py (0644)" \
		"Would install $provider_source/yubikey_provider.py -> $provider_destination/yubikey_provider.py (0644)" \
		"Would install $provider_source/providers.py -> $provider_destination/providers.py (0644)" \
		"Would install $wrapper_source -> $wrapper_destination (0755)" \
		"Would install $desktop_source -> $desktop_destination (0644)"
	exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
	echo "install-secrets-on-phone --apply must run as root" >&2
	exit 1
fi

if pgrep -f '/usr/bin/secrets' >/dev/null; then
	echo "GNOME Secrets is running; close it before applying the overlay" >&2
	exit 1
fi

apk add $packages

rm -rf /usr/local/share/oneplus-secrets-nfc
install -d "$provider_destination" /usr/local/bin /usr/local/share/applications
install -m 0644 "$provider_source/oneplus_pcsc.py" \
	"$provider_destination/oneplus_pcsc.py"
install -m 0644 "$provider_source/secrets_composite.py" \
	"$provider_destination/secrets_composite.py"
install -m 0644 "$provider_source/yubikey_provider.py" \
	"$provider_destination/yubikey_provider.py"
install -m 0644 "$provider_source/providers.py" \
	"$provider_destination/providers.py"
install -m 0755 "$wrapper_source" "$wrapper_destination"
install -m 0644 "$desktop_source" "$desktop_destination"

desktop-file-validate "$desktop_destination"
update-desktop-database /usr/local/share/applications

echo "Installed GNOME Secrets NFC provider overlay"
